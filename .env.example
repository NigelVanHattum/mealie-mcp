# Mealie MCP Server — environment variables
# Copy to .env and fill in values (or use a /config/config.json mount instead).

# Base URL of your Mealie instance (no trailing slash).
MEALIE_BASE_URL=https://mealie.example.com

# Required: a long-lived API token (Mealie -> Settings -> API Tokens).
# The server authenticates to Mealie with API keys only.
MEALIE_API_TOKEN=your-api-token-here

# Set to false only for self-signed certificates.
MEALIE_VERIFY_SSL=true

# Optional: override server bind settings.
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# Optional: override config file directory for the docker-compose volume mount.
# MEALIE_CONFIG_DIR=~/.config/mealie-mcp
